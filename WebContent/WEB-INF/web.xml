<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns="http://java.sun.com/xml/ns/javaee" xmlns:web="http://java.sun.com/xml/ns/javaee" xsi:schemaLocation="http://java.sun.com/xml/ns/javaee http://java.sun.com/xml/ns/javaee/web-app_2_5.xsd" id="WebApp_ID" version="2.5">
  <display-name>SegmentSearch</display-name>
  <resource-ref>
    <description>MySQL DataSource</description>
    <res-ref-name>jdbc/segmentdb</res-ref-name>
    <res-type>javax.sql.DataSource</res-type>
    <res-auth>Container</res-auth>
  </resource-ref>
  <!-- 检查用户是否登录过的web.xml配置 
<filter>  
    <filter-name>AuthFilter</filter-name>  
    <filter-class>filter.AuthFilter</filter-class>  
</filter>  

<filter-mapping>  
    <filter-name>AuthFilter</filter-name>  
    <url-pattern>*.jsp</url-pattern>  
</filter-mapping>  
-->  
  <filter>
    <filter-name>SecurityHeaderFilter</filter-name>
    <filter-class>filter.SecurityHeaderFilter</filter-class>
  </filter>
  <filter>
    <filter-name>CharactorEncodingFilter</filter-name>
    <filter-class>filter.CharactorEncodingFilter</filter-class>
  </filter>
  <filter>
    <filter-name>HtmlFilter</filter-name>
    <filter-class>filter.HtmlFilter</filter-class>
  </filter>
  <filter>
    <filter-name>CsrfFilter</filter-name>
    <filter-class>filter.CsrfFilter</filter-class>
  </filter>
  <filter-mapping>
    <filter-name>SecurityHeaderFilter</filter-name>
    <url-pattern>/*</url-pattern>
  </filter-mapping>
  <filter-mapping>
    <filter-name>CharactorEncodingFilter</filter-name>
    <url-pattern>/*</url-pattern>
  </filter-mapping>
  <filter-mapping>
    <filter-name>HtmlFilter</filter-name>
    <url-pattern>/*</url-pattern>
  </filter-mapping>
  <filter-mapping>
    <filter-name>CsrfFilter</filter-name>
    <url-pattern>/*</url-pattern>
  </filter-mapping>
  <welcome-file-list>
    <welcome-file>index.html</welcome-file>
    <welcome-file>index.htm</welcome-file>
    <welcome-file>index.jsp</welcome-file>
    <welcome-file>default.html</welcome-file>
    <welcome-file>default.htm</welcome-file>
    <welcome-file>default.jsp</welcome-file>
  </welcome-file-list>
  <servlet>
    <description></description>
    <display-name>Login</display-name>
    <servlet-name>Login</servlet-name>
    <servlet-class>web.client.LoginServlet</servlet-class>
  </servlet>
  <servlet-mapping>
    <servlet-name>Login</servlet-name>
    <url-pattern>/Login</url-pattern>
  </servlet-mapping>
  <servlet>
    <description></description>
    <display-name>Sample</display-name>
    <servlet-name>Sample</servlet-name>
    <servlet-class>web.client.SampleServlet</servlet-class>
  </servlet>
  <servlet-mapping>
    <servlet-name>Sample</servlet-name>
    <url-pattern>/Sample</url-pattern>
  </servlet-mapping>
</web-app>